{
    "$schema": "https://aka.ms/terminal-profiles-schema",

    // Only settings that differ from Windows Terminal's shipped defaults
    // (its defaults.json, openable with ctrl+alt+,) are defined here.

    // Default is the Windows PowerShell profile.
    "defaultProfile": "{2c4de342-38b7-51cf-b940-2309a097f518}",
    // Default is true, which copies with formatting; we want plain text.
    "copyFormatting": "none",
    "theme": "Catppuccin Mocha",

    "profiles": {
        "defaults": {
            "colorScheme": "Catppuccin Mocha",
            "font": {
                "face": "FiraCode Nerd Font",
                "size": 13
            },
            // Defaults: "bar" cursor, "audible" bell, 8px padding.
            "cursorShape": "filledBox",
            "bellStyle": "none",
            "padding": "0"
        },
        // Every profile is listed explicitly, including the dynamically
        // generated ones. Windows Terminal records generated profile GUIDs in
        // LocalState/state.json ("generatedProfiles"); once a GUID is in that
        // list, leaving it out of this list reads as "the user deleted this
        // profile" and Windows Terminal will not re-add it. So omitting a
        // generated profile hides it permanently rather than falling back to
        // a default - this is not a section to minimise.
        "list": [
            {
                // Renamed, and skips the startup banner.
                "guid": "{61c54bbd-c2c6-5271-96e7-009a87ff44bf}",
                "name": "PowerShell",
                "commandline": "powershell.exe -NoLogo",
                "hidden": false
            },
            {
                // Always elevates, prompting for UAC on launch. Named without
                // spaces so `wt -p Admin` needs no quoting -- it is launched
                // that way from the GlazeWM binding.
                "guid": "{7c1a4b90-6e3d-4c85-9f2a-5d8e0b3c1f47}",
                "name": "Admin",
                "commandline": "powershell.exe -NoLogo",
                "elevate": true,
                "icon": "ms-appx:///ProfileIcons/{61c54bbd-c2c6-5271-96e7-009a87ff44bf}.png",
                "hidden": false
            },
            {
                // Generated by the WSL generator; renamed from "Ubuntu".
                "guid": "{2c4de342-38b7-51cf-b940-2309a097f518}",
                "source": "Windows.Terminal.Wsl",
                "name": "WSL",
                "hidden": false
            },
            {
                "guid": "{0caa0dad-35be-5f56-a8ff-afceeeaa6101}",
                "name": "Command Prompt",
                "commandline": "cmd.exe",
                "hidden": false
            },
            {
                "guid": "{b453ae62-4e3d-5e58-b989-0a998ec441b8}",
                "source": "Windows.Terminal.Azure",
                "name": "Azure Cloud Shell",
                "hidden": true
            }
        ]
    },

    // Windows Terminal ships no Catppuccin scheme, so it has to be defined.
    "schemes": [
        {
            "name": "Catppuccin Mocha",
            "cursorColor": "#F5E0DC",
            "selectionBackground": "#585B70",
            "background": "#1E1E2E",
            "foreground": "#CDD6F4",
            "black": "#45475A",
            "red": "#F38BA8",
            "green": "#A6E3A1",
            "yellow": "#F9E2AF",
            "blue": "#89B4FA",
            "purple": "#F5C2E7",
            "cyan": "#94E2D5",
            "white": "#BAC2DE",
            "brightBlack": "#585B70",
            "brightRed": "#F38BA8",
            "brightGreen": "#A6E3A1",
            "brightYellow": "#F9E2AF",
            "brightBlue": "#89B4FA",
            "brightPurple": "#F5C2E7",
            "brightCyan": "#94E2D5",
            "brightWhite": "#A6ADC8"
        }
    ],

    // Only the chrome colors: iconStyle, showCloseButton, unfocusedBackground
    // and useMica already match the defaults. applicationTheme defaults to
    // "system", so dark has to be stated.
    "themes": [
        {
            "name": "Catppuccin Mocha",
            "tab": { "background": "#1E1E2EFF" },
            "tabRow": {
                "background": "#181825FF",
                "unfocusedBackground": "#11111BFF"
            },
            "window": { "applicationTheme": "dark" }
        }
    ],

    // closeTab is the only action here without a built-in id: Windows Terminal
    // leaves it unbound because it closes a multi-pane tab without confirming.
    "actions": [
        { "command": { "action": "closeTab" }, "id": "User.closeTab" }
    ],

    // Only bindings that differ from the defaults. Left to the defaults:
    // ctrl+shift+c/v (copy/paste), ctrl+shift+f (find), ctrl+shift+t (new
    // tab), ctrl+tab and ctrl+shift+tab (tab nav), ctrl+alt+1..8 (jump to
    // tab), ctrl+, (settings). ctrl+c and ctrl+v need no unbinding - Windows
    // Terminal does not bind them at all (it uses ctrl+insert/shift+insert),
    // so they already pass through to the shell and neovim.
    "keybindings": [
        // Default here is closePane; close the whole tab instead.
        { "keys": "ctrl+shift+w", "id": "User.closeTab" }
    ]
}
